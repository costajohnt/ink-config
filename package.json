{
	"name": "@costajohnt/ink-config",
	"version": "1.0.0",
	"description": "Shared tsconfig, xo config, and CI workflow for costajohnt's Ink component libraries",
	"license": "MIT",
	"repository": "costajohnt/ink-config",
	"type": "module",
	"exports": {
		"./xo": "./xo.js",
		"./tsconfig.json": "./tsconfig.json"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "xo",
		"test": "tsc -p test/fixture --noEmit"
	},
	"files": [
		"xo.js",
		"tsconfig.json"
	],
	"keywords": [
		"ink",
		"xo",
		"tsconfig",
		"config"
	],
	"dependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"eslint-config-xo-react": "^0.32.0"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"xo": "^5.0.1"
	},
	"peerDependencies": {
		"typescript": ">=5.9",
		"xo": ">=5"
	}
}
